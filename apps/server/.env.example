# ── Database (Neon) ─────────────────────────────────────────────
# Pooled connection (host contains "-pooler") used by the app at runtime.
# Do NOT add pgbouncer=true: Neon's pooler supports prepared statements and the
# flag makes every Prisma query ~3x slower. Do NOT include channel_binding=require:
# Prisma's engine doesn't support it and hangs.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=5
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# ── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000       # public web origin (used in invoice links)
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000  # comma-separated
TRUST_PROXY=1                       # 2 in production (Vercel rewrite + Render)

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET=                          # openssl rand -hex 32
JWT_EXPIRES_IN=7d

# ── Email (Brevo) - backend only, never exposed to Next.js ─────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Organo Healers

# ── Seed ────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@organohealers.local
SEED_ADMIN_PASSWORD=                 # choose a strong password
