{
  "name": "organo-healers",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm run dev -w @organo/server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w @organo/server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w @organo/server && npm run build -w web",
    "test": "npm run test -w @organo/shared && npm run test -w @organo/server",
    "typecheck": "npm run typecheck -w @organo/shared && npm run typecheck -w @organo/server && npm run typecheck -w web",
    "db:generate": "npm run db:generate -w @organo/server",
    "db:migrate": "npm run db:migrate -w @organo/server",
    "db:deploy": "npm run db:deploy -w @organo/server",
    "db:seed": "npm run db:seed -w @organo/server",
    "db:studio": "npm run db:studio -w @organo/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "puppeteer@24.43.1": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.5": true,
    "sharp@0.35.5": true
  },
  "dependencies": {
    "tree": "^0.1.3"
  }
}
